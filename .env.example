# Database
DB_HOST=localhost
DB_NAME=weatherdb
DB_USER=postgres
DB_PASS=replace-with-local-password
DB_PORT=5432
DB_SSLMODE=prefer

# Email
GMAIL_USER=replace-with-sender-email
GMAIL_APP_PASSWORD=replace-with-app-password
RECEIVER_EMAIL=replace-with-recipient-email

# OpenWeather
OPENWEATHER_API_KEY=replace-with-api-key

# Twilio
TWILIO_ACCOUNT_SID=replace-with-account-sid
TWILIO_AUTH_TOKEN=replace-with-auth-token
TWILIO_FROM_NUMBER=replace-with-twilio-number
TWILIO_TO_NUMBER=replace-with-recipient-number

# Set true to record notification attempts without contacting providers.
NOTIFICATION_TEST_MODE=false
NOTIFICATION_MAX_RETRIES=2

# Application runtime
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=false
CORS_ORIGINS=http://localhost:3000
